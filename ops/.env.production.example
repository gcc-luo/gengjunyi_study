# Public DNS must point both hostnames to this Ubuntu server before first startup.
APP_DOMAIN=learn.example.com
APP_ORIGIN=https://learn.example.com
S3_DOMAIN=s3.learn.example.com

# Use URL-safe hexadecimal secrets: openssl rand -hex 24
POSTGRES_DB=family_learning
POSTGRES_USER=family_learning
POSTGRES_PASSWORD=replace_with_48_hex_characters
MINIO_ROOT_USER=family_minio_root
MINIO_ROOT_PASSWORD=replace_with_a_long_random_secret
MINIO_APP_SECRET_KEY=replace_with_a_different_long_random_secret
MINIO_BUCKET=family-learning-videos

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace_with_openssl_rand_base64_48_output
APP_TIMEZONE=Asia/Shanghai

# Must match the fixed Caddy IPv4 address in ops/compose.production.yaml.
TRUSTED_PROXIES=172.30.42.2
