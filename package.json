{
  "name": "family-learning-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "test:server": "npm run prisma:generate && vitest run server/test --exclude server/test/db/**",
    "test:db": "npm run prisma:generate && vitest run server/test/db",
    "test:all": "npm run test && npm run test:server && npm run test:db",
    "test:e2e": "playwright test",
    "server:dev": "npm run prisma:generate && tsx watch server/src/index.ts",
    "worker:dev": "npm run prisma:generate && tsx watch server/src/worker.ts",
    "server:build": "npm run prisma:generate && tsc -p server/tsconfig.json",
    "server:start": "node server/dist/index.js",
    "worker:start": "node server/dist/worker.js",
    "admin:create": "tsx server/scripts/create-admin.ts",
    "storage:init": "tsx server/scripts/init-storage.ts",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma --config server/prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma --config server/prisma.config.ts",
    "db:seed": "npm run prisma:generate && prisma db seed --config server/prisma.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "^5.103.1",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "17.4.2",
    "jsdom": "^25.0.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
